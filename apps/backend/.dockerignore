__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*

# The dataset table (GET /api/dataset) reads the source CSV and the prepared Parquet
# files. Model artifacts stay out of the image and are mounted at runtime.
ml/data/raw/*
!ml/data/raw/*.csv
ml/data/processed/*
!ml/data/processed/*.parquet
ml/data/manifests/*
!ml/data/manifests/dataset.json
ml/artifacts/*
ml/experiments/*
ml/notebooks/*
tests/
