# Smart Food Delivery Time Prediction - environment example
# Copy to .env for Docker Compose. For local `npm run dev`, copy the web values
# to apps/web/.env.local.

# Backend API settings
API_HOST=0.0.0.0
API_PORT=8600
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3600
# demo: labelled placeholder results. model: serve ml/artifacts/v1/model.joblib.
PREDICTION_MODE=demo
# Optional. Use a model file in another location.
MODEL_PATH=

# Web frontend settings (used in the browser; must be reachable from the host)
WEB_PORT=3600
NEXT_PUBLIC_API_BASE_URL=http://localhost:8600
# api: call FastAPI. mock: frontend-only demo results for UI work without the API.
NEXT_PUBLIC_PREDICTION_MODE=api

# Map services. These are free public URLs, not secrets, and need no sign-up.
# The app uses these same values if they are left empty. Change them only if
# you host your own map, search, or routing server.
NEXT_PUBLIC_MAP_STYLE_LIGHT_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
NEXT_PUBLIC_GEOCODING_URL=https://photon.komoot.io
NEXT_PUBLIC_ROUTING_URL=https://router.project-osrm.org
