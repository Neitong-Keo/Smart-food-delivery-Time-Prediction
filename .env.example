# Smart Food Delivery Time Prediction - Phase 1 Environment Example
# Copy to .env (or load into your PowerShell session) before starting services.

# Backend API settings
API_HOST=0.0.0.0
API_PORT=8600
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3600

# Web frontend settings (used in the browser; must be reachable from the host)
WEB_PORT=3600
NEXT_PUBLIC_API_BASE_URL=http://localhost:8600

